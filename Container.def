Bootstrap: docker
From: mambaorg/micromamba
# Use micromamba for package handling

%files
    # Copy the whole directory
    . /app

%post
    # Set the base environment to activate
    MAMBA_DOCKERFILE_ACTIVATE=1

    # Install the environment from file
    micromamba install --yes --name base -f /app/environment.yml

    # Install the package in the copied folder using pip
    cd /app
    micromamba run -n base pip install -e .

    # Clean up lock files
    micromamba clean -a --yes --locks

%environment
    # Set the base environment to activate on run
    export MAMBA_DOCKERFILE_ACTIVATE=1
    
    # Add mamba to the path to ensure python is executable
    export PATH=/opt/conda/bin:$PATH

%runscript
    # Execute the input command with activated base environment
    sh /usr/local/bin/_entrypoint.sh "$@"

%test
    python -c "import pangenometools"